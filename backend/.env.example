# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=

# Project database (PostgreSQL). In production set DATABASE_URL, e.g.
#   postgresql://svsu:<password>@db-host:5432/svsu_assistant
# Leave it blank locally to run a PostgreSQL server with its data in PG_DATA_DIR.
DATABASE_URL=
PG_DATA_DIR=D:/PostgreSQL/data

# OCR with Tesseract (runs once at upload). Needs the eng, hin and osd language files.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_DIR=D:/Tesseract-OCR/tessdata

# Sign-in tokens — use a long random value in production.
JWT_SECRET=
# Load the prototype's 16 sample documents into an empty database (development only).
DEMO_DATA=false

# Local test admin (dev only — leave blank in production).
DEV_ADMIN_USER=
DEV_ADMIN_PASS=

# Web app address(es) allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Deadline reminder emails (optional). Leave SMTP_HOST blank for in-app reminders only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
