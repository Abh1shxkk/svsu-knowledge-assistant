# secrets — never commit (only the blank .env.example templates are tracked)
.env
.env.*
!.env.example

# python
__pycache__/
*.pyc
.venv/
venv/

# node / next
node_modules/
.next/
dist/
*.tsbuildinfo

# logs and scratch
*.log
.tmp/

# os
.DS_Store
Thumbs.db

# browser tests
test-results/
playwright-report/

# keys and certificates — never commit
*.pem
*.key

# deployment secrets and build output
deploy/.env
deploy/web/
frontend/.next-prod/
